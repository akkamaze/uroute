# Copy to deploy/.env on the NAS only after confirming the staging database and HTTPS origin.
# Never commit real credentials. Keep staging and production databases/roles separate.
DATABASE_URL=postgresql://uroute_staging_app:CHANGE_ME@STAGING_POSTGRES_ADDRESS:5432/uroute_staging
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://STAGING_HOSTNAME
TRUSTED_ORIGINS=https://STAGING_HOSTNAME
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only set exact reverse-proxy peer IPs after verifying the tunnel topology.
TRUSTED_PROXY_IPS=
# Compose publishes the web service to this NAS interface and port.
# Verify the tunnel can reach it and the port is unused before deployment.
BIND_ADDRESS=127.0.0.1
WEB_PORT=CHOOSE_UNUSED_STAGING_PORT
